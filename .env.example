# Salin ke .env.local untuk pengembangan lokal (opsional).
# Tanpa TURSO_DATABASE_URL, aplikasi memakai file lokal data/kerjaharian.db.

# URL database Turso, mis. libsql://kerjaharian-namaanda.turso.io
TURSO_DATABASE_URL=
# Token dari: turso db tokens create kerjaharian
TURSO_AUTH_TOKEN=

# Email verifikasi via Resend (https://resend.com, gratis 3.000 email/bulan).
# Tanpa RESEND_API_KEY, fitur verifikasi email disembunyikan dan email hanya dicetak ke log.
RESEND_API_KEY=
# Alamat pengirim; domain harus sudah diverifikasi di Resend.
EMAIL_FROM="Kerja Harian <noreply@kerja-harian.id>"
# URL situs untuk tautan di email (opsional; default dari header request).
# NEXT_PUBLIC_SITE_URL=https://www.kerja-harian.id

# Verifikasi nomor WhatsApp (OTP) via Fonnte (https://fonnte.com).
# Tanpa FONNTE_TOKEN, kartu verifikasi WhatsApp disembunyikan.
FONNTE_TOKEN=
# Pengembangan lokal: set 1 agar kode OTP hanya dicetak ke log (tanpa Fonnte).
# WHATSAPP_LOG_ONLY=1

# Isi data demo (akun demo1234). Default: aktif secara lokal, nonaktif di Vercel.
# SEED_DEMO_DATA=1
