# Salin ke .env.local untuk pengembangan lokal (opsional).
# Tanpa TURSO_DATABASE_URL, aplikasi memakai file lokal data/kerjaharian.db.

# URL database Turso, mis. libsql://kerjaharian-namaanda.turso.io
TURSO_DATABASE_URL=
# Token dari: turso db tokens create kerjaharian
TURSO_AUTH_TOKEN=

# Isi data demo (akun demo1234). Default: aktif secara lokal, nonaktif di Vercel.
# SEED_DEMO_DATA=1
